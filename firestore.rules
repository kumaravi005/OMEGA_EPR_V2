rules_version = '2';

// Authentication/user-account security posture (Set 2), extended with
// teacher/student/batch/fee records (Set 3).
//
// No Cloud Functions/Admin SDK are used anywhere in this project (Spark
// plan) - every rule below is enforced purely by Firestore security
// rules, which run server-side and can't be bypassed by a modified
// client. `role` lives on each account's own Firestore document; a
// client can never set/change its OWN role (see `allow update` below),
// and only an existing admin may `create` a new account at all - so a
// client can never grant itself a role it wasn't given. The very first
// admin account is created once, manually, via the Firebase Console
// (see docs/firebase-setup.md) - the Console bypasses these rules the
// same way the Admin SDK would, so no special-case bootstrap rule is
// needed here.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function callerAccount() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && callerAccount().role == 'admin'
        && callerAccount().active == true;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTeacher() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && callerAccount().role == 'teacher'
        && callerAccount().active == true;
    }

    // For "student may read their batch's homework/assignments/tests/
    // attendance" checks - based on the student's CURRENT batch.
    function callerStudentDoc() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
    }

    // Uses .get(key, default) rather than dot access - a `students/{uid}`
    // document missing `batchId`/`active` entirely (e.g. one created
    // directly in the Firebase Console instead of through the app's
    // admission flow, which always writes every required field) would
    // otherwise make Firestore Rules THROW on a bare `.batchId`/`.active`
    // access - a rule that throws denies the request, but as an opaque
    // internal error rather than a clean, deliberate "not this student's
    // batch"/"not active" denial. Behavior for any complete document
    // (every one created through the app) is identical either way.
    function isStudentOfBatch(batchId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && callerStudentDoc().get('batchId', '') == batchId
        && callerStudentDoc().get('active', false) == true;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Admin may toggle `active`/`displayName` and/or clear `session` (to
    // force a legitimate device replacement) on any account - never
    // role, accountId, uid or the other identity fields, and never
    // *set* a session to an arbitrary value (only null it).
    function adminUpdateIsValid() {
      return changedKeys().hasOnly(['active', 'session', 'updatedAt', 'displayName'])
        && (!changedKeys().hasAny(['session']) || request.resource.data.session == null)
        && (!changedKeys().hasAny(['active']) || request.resource.data.active is bool)
        && (
          !changedKeys().hasAny(['displayName'])
          || (request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2)
        );
    }

    // A signed-in user may only ever touch their OWN session/lastLoginAt -
    // this is the single-device login enforcement. Clearing session
    // (logout) is always allowed. Claiming a session (login) is only
    // allowed if the account is active, and the existing session is
    // either absent, already this same device, or stale (no heartbeat for
    // 30+ minutes, e.g. the app crashed without a clean logout).
    function selfSessionUpdateIsValid() {
      let newSession = request.resource.data.session;
      return changedKeys().hasOnly(['session', 'lastLoginAt', 'updatedAt'])
        && (
          !changedKeys().hasAny(['session'])
          || newSession == null
          || (
            resource.data.active == true
            && newSession.deviceId is string
            && newSession.loginAt is timestamp
            && newSession.lastSeenAt is timestamp
            && (
              resource.data.session == null
              || resource.data.session.deviceId == newSession.deviceId
              || resource.data.session.lastSeenAt < request.time - duration.value(30, 'm')
            )
          )
        );
    }

    // The Firebase Auth user is always created first (via a throwaway
    // secondary app instance, client-side - see AccountProvisioningService),
    // so accountId/email uniqueness is already guaranteed by Firebase
    // Auth by the time this document write happens. Only an admin may
    // perform it, and only with a well-formed, freshly-provisioned
    // account (active, no session yet, no extra fields).
    function newAccountIsValid(userId) {
      let data = request.resource.data;
      return data.uid == userId
        && data.accountId is string && data.accountId.size() >= 3
        && data.role in ['admin', 'teacher', 'student']
        && data.displayName is string && data.displayName.size() >= 2
        && data.active == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastLoginAt == null
        && data.session == null
        && data.keys().hasOnly(
          ['uid', 'accountId', 'role', 'displayName', 'active', 'createdAt', 'updatedAt', 'lastLoginAt', 'session']
        );
    }

    match /users/{userId} {
      allow get: if isAdmin() || isSelf(userId);
      allow list: if isAdmin();

      allow create: if isAdmin() && newAccountIsValid(userId);

      // Own document (even an admin's own) always goes through the
      // self-session rules, so an admin can log themself in/out exactly
      // like anyone else. Admin-management rules only apply to a
      // *different* account.
      allow update: if isSelf(userId) ? selfSessionUpdateIsValid() : (isAdmin() && adminUpdateIsValid());

      // No client-side delete; admin deactivates via `active: false`
      // instead, so no account/session history is lost.
      allow delete: if false;

      // Per-user notice read state (Set 17 section 15): one document per
      // notice the user has opened, at `users/{uid}/noticeReadStates/{noticeId}`
      // - never a growing array on the notice itself, never a fan-out write
      // touching every recipient's document. Absence means unread; nothing
      // is ever written for an unread notice. Immutable once created (no
      // `update`) - `markNoticeRead` (Dart) checks the current state first
      // so it never attempts to re-create an existing document. A user may
      // only ever read/write their OWN read state - never another user's
      // (section 18/28).
      function newNoticeReadStateIsValid() {
        return request.resource.data.readAt is timestamp
          && request.resource.data.keys().hasOnly(['readAt']);
      }

      match /noticeReadStates/{noticeId} {
        allow get, list: if isSelf(userId);
        allow create: if isSelf(userId) && newNoticeReadStateIsValid();
        allow update, delete: if false;
      }
    }

    // Teacher profiles (Set 3, extended Set 12 with a photo URL, a
    // subjectIds capability list referencing the Set 9 subject master,
    // and active/inactive status - replacing the old free-text
    // `assignments` [{className, subject}] pairs, which were never
    // cross-referenced against anything and are confirmed unused outside
    // this collection). Admin-managed only. A teacher may read their own
    // profile but never write it - editing is exclusively an admin
    // action (see docs/database-architecture.md).
    function teacherFields() {
      return [
        'uid', 'accountId', 'name', 'dateOfBirth', 'gender', 'photoUrl', 'qualification', 'address',
        'primaryMobile', 'secondaryMobile', 'subjectIds', 'active', 'createdAt', 'updatedAt'
      ];
    }

    function newTeacherIsValid(teacherId) {
      let data = request.resource.data;
      return data.uid == teacherId
        && data.accountId is string
        && data.name is string && data.name.size() >= 2
        && data.dateOfBirth is timestamp
        && data.gender in ['male', 'female', 'other']
        && (data.photoUrl == null || data.photoUrl is string)
        && data.qualification is string
        && data.address is string
        && data.primaryMobile is string && data.primaryMobile.size() >= 6
        && data.subjectIds is list
        && data.active == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(teacherFields());
    }

    // Tolerates the ABSENCE of every Set-12-added field (and the
    // presence of the now-removed `assignments`, which a full edit-form
    // save always omits and `setActive` now explicitly deletes) -
    // exactly the same backward-compatibility pattern as
    // `batchUpdateIsValid`/`studentUpdateIsValid` (Sets 10-11): a
    // pre-Set-12 teacher document has none of the new fields, so a
    // partial `.update()` (`setActive`) keeps working unchanged, while a
    // full profile save (which always supplies every current field) is
    // still fully validated.
    function teacherUpdateIsValid() {
      let data = request.resource.data;
      let keys = data.keys();
      return data.uid == resource.data.uid
        && data.accountId == resource.data.accountId
        && data.createdAt == resource.data.createdAt
        && (!keys.hasAny(['photoUrl']) || data.photoUrl == null || data.photoUrl is string)
        && (!keys.hasAny(['subjectIds']) || data.subjectIds is list)
        && (!keys.hasAny(['active']) || data.active is bool)
        && keys.hasOnly(teacherFields());
    }

    match /teachers/{teacherId} {
      allow get: if isAdmin() || isSelf(teacherId);
      allow list: if isAdmin();
      allow create: if isAdmin() && newTeacherIsValid(teacherId);
      allow update: if isAdmin() && teacherUpdateIsValid();
      allow delete: if false;
    }

    // Student admission + fee records (Set 3, extended Set 11 with the
    // Set 9/10 master-data links, an admission number, a photo URL, and
    // a pointer to the current admission's history record - see
    // `students/{studentId}/admissions` below). Admin-managed only. A
    // student/parent may read their own record but never write it.
    // `standardFee` is a snapshot for reference; `finalFee` is what
    // every payment/due calculation actually uses. `className`/`board`/
    // `academicSession` are display strings resolved from master data at
    // admission/transfer time (Set 11) - `academicSessionId`/`classId`/
    // `boardId` are the authoritative references.
    function studentFields() {
      return [
        'uid', 'accountId', 'admissionNumber', 'name', 'fatherName', 'dateOfBirth', 'gender', 'photoUrl',
        'address', 'className', 'board', 'batchId', 'academicSession', 'academicSessionId', 'classId', 'boardId',
        'boardCustomText', 'primaryMobile', 'secondaryMobile', 'standardFee', 'finalFee', 'feeReason',
        'paymentPlan', 'admissionDate', 'currentAdmissionId', 'active', 'createdAt', 'updatedAt'
      ];
    }

    function newStudentIsValid(studentId) {
      let data = request.resource.data;
      return data.uid == studentId
        && data.accountId is string
        && data.admissionNumber is string && data.admissionNumber.size() > 0
        && data.name is string && data.name.size() >= 2
        && data.fatherName is string
        && data.dateOfBirth is timestamp
        && data.gender in ['male', 'female', 'other']
        && (data.photoUrl == null || data.photoUrl is string)
        && data.address is string
        && data.className is string
        && data.board is string
        && data.batchId is string
        && data.academicSession is string
        && data.academicSessionId is string && data.academicSessionId.size() > 0
        && data.classId is string && data.classId.size() > 0
        && (data.boardId == null || data.boardId is string)
        && (data.boardCustomText == null || data.boardCustomText is string)
        && data.primaryMobile is string && data.primaryMobile.size() >= 6
        && data.standardFee is number && data.standardFee >= 0
        && data.finalFee is number && data.finalFee >= 0
        && data.paymentPlan in ['monthly', 'installment']
        && data.admissionDate is timestamp
        && data.currentAdmissionId is string && data.currentAdmissionId.size() > 0
        && data.active == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(studentFields());
    }

    // Tolerates the ABSENCE of every Set-11-added field, exactly like
    // `batchUpdateIsValid` (Set 10) - a pre-Set-11 student document has
    // none of them, so a partial `.update()` (e.g. `setActive` toggling
    // just `active`) must keep working without first forcing a full
    // edit-form migration, while a full edit-form/admission save (which
    // always supplies every field) is still fully validated.
    function studentUpdateIsValid() {
      let data = request.resource.data;
      let keys = data.keys();
      return data.uid == resource.data.uid
        && data.accountId == resource.data.accountId
        && data.createdAt == resource.data.createdAt
        && data.finalFee is number && data.finalFee >= 0
        && data.standardFee is number && data.standardFee >= 0
        && (!keys.hasAny(['admissionNumber']) || (data.admissionNumber is string && data.admissionNumber.size() > 0))
        && (!keys.hasAny(['photoUrl']) || data.photoUrl == null || data.photoUrl is string)
        && (!keys.hasAny(['academicSessionId']) || data.academicSessionId is string)
        && (!keys.hasAny(['classId']) || data.classId is string)
        && (!keys.hasAny(['boardId']) || data.boardId == null || data.boardId is string)
        && (!keys.hasAny(['boardCustomText']) || data.boardCustomText == null || data.boardCustomText is string)
        && (!keys.hasAny(['admissionDate']) || data.admissionDate is timestamp)
        && (!keys.hasAny(['currentAdmissionId']) || data.currentAdmissionId is string)
        && keys.hasOnly(studentFields());
    }

    function newPaymentIsValid() {
      let data = request.resource.data;
      return data.amount is number && data.amount > 0
        && data.date is timestamp
        && data.mode in ['cash', 'upi', 'bankTransfer', 'cheque', 'other']
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.keys().hasOnly(['amount', 'date', 'mode', 'remark', 'createdAt', 'createdBy']);
    }

    // Admission/enrollment history (Set 11): one immutable-once-created
    // record per admission event (initial admission, or a later batch
    // transfer) - kept separate from the student's own identity so a
    // historical fee agreement is never overwritten by a later change
    // (see docs/database-architecture.md). The only update ever allowed
    // afterward is flipping `active` to false when a newer admission
    // supersedes this one - every financial/academic figure on it is
    // otherwise permanent.
    function admissionFields() {
      return [
        'studentUid', 'academicSessionId', 'classId', 'batchId', 'boardId', 'boardCustomText', 'standardFee',
        'finalFee', 'feeReason', 'paymentPlan', 'installments', 'admissionDate', 'active', 'configuredByUid',
        'createdAt', 'updatedAt'
      ];
    }

    function newAdmissionIsValid(studentId) {
      let data = request.resource.data;
      return data.studentUid == studentId
        && data.academicSessionId is string && data.academicSessionId.size() > 0
        && data.classId is string && data.classId.size() > 0
        && data.batchId is string && data.batchId.size() > 0
        && (data.boardId == null || data.boardId is string)
        && (data.boardCustomText == null || data.boardCustomText is string)
        && data.standardFee is number && data.standardFee >= 0
        && data.finalFee is number && data.finalFee >= 0
        && (data.feeReason == null || data.feeReason is string)
        && data.paymentPlan in ['monthly', 'installment']
        && data.installments is list
        && data.admissionDate is timestamp
        && data.active is bool
        && data.configuredByUid is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(admissionFields());
    }

    function admissionUpdateIsValid() {
      return changedKeys().hasOnly(['active', 'updatedAt']) && request.resource.data.active is bool;
    }

    match /students/{studentId} {
      // A teacher needs the roster (e.g. to enter marks / mark
      // attendance for a batch) - same "any active teacher may work
      // with any batch" scope decision already made for homework/
      // assignments/tests (see docs/database-architecture.md), not a
      // per-assignment restriction.
      allow get: if isAdmin() || isTeacher() || isSelf(studentId);
      allow list: if isAdmin() || isTeacher();
      allow create: if isAdmin() && newStudentIsValid(studentId);
      allow update: if isAdmin() && studentUpdateIsValid();
      allow delete: if false;

      // Payments are an append-only financial record - admin records
      // them, nobody edits or deletes them afterwards. A student/parent
      // may read their own payment history.
      match /payments/{paymentId} {
        allow get: if isAdmin() || isSelf(studentId);
        allow list: if isAdmin() || isSelf(studentId);
        allow create: if isAdmin() && newPaymentIsValid();
        allow update, delete: if false;
      }

      // A student/parent may see their own admission history (e.g. past
      // sessions/batches); never write it - see admissionUpdateIsValid
      // above for the one thing an admin may change after creation.
      match /admissions/{admissionId} {
        allow get: if isAdmin() || isSelf(studentId);
        allow list: if isAdmin() || isSelf(studentId);
        allow create: if isAdmin() && newAdmissionIsValid(studentId);
        allow update: if isAdmin() && admissionUpdateIsValid();
        allow delete: if false;
      }
    }

    // Fee Collection & Payment Management (Set 19) - the real payment
    // ledger, a TOP-LEVEL collection (not nested under `students/{uid}`
    // like the legacy `payments` subcollection above, which is kept
    // exactly as-is, read-only, for pre-Set-19 history - see docs/
    // database-architecture.md). `studentId`/`admissionId`/
    // `academicSessionId`/`classId`/`batchId`/`finalFeeAtPayment` are
    // snapshotted at creation and NEVER change afterward - not even a
    // reversal may touch them - so a later admission/batch change, or a
    // later edit to the admission's own fee agreement, can never rewrite
    // what a past payment actually was (Set 19's core "historical
    // financial data must never be rewritten" principle).
    //
    // Admin-only to create/update; a student/parent may read only their
    // OWN payments (`isSelf(resource.data.studentId)` for `get`, and a
    // `list` query constrained by `.where('studentId', ==, uid)` for the
    // same reason `academicWork`/`notices` need a query-shape-matching
    // filter - see "Firestore query-shape requirement" below). No
    // teacher branch at all - "no existing project rule explicitly
    // requires" teacher fee access (Set 19 section 21), and none of the
    // legacy `payments` subcollection's rules grant it either. `delete`
    // is never allowed - a mistaken payment is reversed, never removed.
    function feePaymentFields() {
      return [
        'paymentNumber', 'studentId', 'admissionId', 'academicSessionId', 'classId', 'batchId', 'amount',
        'paymentDate', 'mode', 'referenceNumber', 'remark', 'installmentIndex', 'installmentLabel',
        'finalFeeAtPayment', 'status', 'reversedBy', 'reversedAt', 'reversalReason', 'collectedBy', 'createdAt'
      ];
    }

    function newFeePaymentIsValid() {
      let data = request.resource.data;
      return data.paymentNumber is string && data.paymentNumber.size() > 0
        && data.studentId is string && data.studentId.size() > 0
        && data.admissionId is string && data.admissionId.size() > 0
        && data.academicSessionId is string && data.academicSessionId.size() > 0
        && data.classId is string && data.classId.size() > 0
        && data.batchId is string && data.batchId.size() > 0
        && data.amount is number && data.amount > 0
        && data.paymentDate is timestamp
        && data.mode in ['cash', 'upi', 'bankTransfer', 'cheque', 'other']
        && (data.referenceNumber == null || (data.referenceNumber is string && data.referenceNumber.size() <= 60))
        && (data.remark == null || (data.remark is string && data.remark.size() <= 500))
        && (data.installmentIndex == null || (data.installmentIndex is number && data.installmentIndex >= 0))
        && (data.installmentLabel == null || data.installmentLabel is string)
        && data.finalFeeAtPayment is number && data.finalFeeAtPayment >= 0
        && data.status == 'active'
        && data.reversedBy == null && data.reversedAt == null && data.reversalReason == null
        && data.collectedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.keys().hasOnly(feePaymentFields());
    }

    // The ONLY update ever allowed: active -> reversed. Every other field
    // is pinned to its original value - a reversal corrects the ledger by
    // adding a marker, never by touching what was actually recorded.
    function feePaymentReversalIsValid() {
      let data = request.resource.data;
      let old = resource.data;
      return old.status == 'active' && data.status == 'reversed'
        && data.reversedBy == request.auth.uid
        && data.reversedAt is timestamp
        && data.reversalReason is string && data.reversalReason.size() > 0 && data.reversalReason.size() <= 500
        && data.paymentNumber == old.paymentNumber && data.studentId == old.studentId
        && data.admissionId == old.admissionId && data.academicSessionId == old.academicSessionId
        && data.classId == old.classId && data.batchId == old.batchId
        && data.amount == old.amount && data.paymentDate == old.paymentDate
        && data.mode == old.mode && data.referenceNumber == old.referenceNumber
        && data.remark == old.remark && data.installmentIndex == old.installmentIndex
        && data.installmentLabel == old.installmentLabel && data.finalFeeAtPayment == old.finalFeeAtPayment
        && data.collectedBy == old.collectedBy && data.createdAt == old.createdAt
        && data.keys().hasOnly(feePaymentFields());
    }

    match /feePayments/{paymentId} {
      allow get: if isAdmin() || isSelf(resource.data.studentId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() && newFeePaymentIsValid();
      allow update: if isAdmin() && feePaymentReversalIsValid();
      allow delete: if false;
    }

    // Batches (Set 3, extended Set 10 with academic-session/class/board
    // links + fee configuration): a shared reference catalogue, not
    // sensitive personal data, so any signed-in account may read it -
    // only admin may create/edit one. `academicSessionId`/`classId` are
    // required going forward (Set 10) - a batch created before Set 10
    // simply has neither field at all, which the app treats as "not yet
    // linked to master data" rather than crashing (see Batch.fromMap);
    // editing that batch through the new form requires filling them in,
    // which is exactly the validation below.
    function batchFields() {
      return [
        'name', 'batchCode', 'description', 'academicSessionId', 'classId', 'boardId', 'boardCustomText',
        'standardMonthlyFee', 'standardInstallmentFee', 'active', 'studentCount', 'createdAt', 'updatedAt'
      ];
    }

    function newBatchIsValid() {
      let data = request.resource.data;
      return data.name is string && data.name.size() >= 2
        && (data.batchCode == null || data.batchCode is string)
        && (data.description == null || data.description is string)
        && data.academicSessionId is string && data.academicSessionId.size() > 0
        && data.classId is string && data.classId.size() > 0
        && (data.boardId == null || data.boardId is string)
        && (data.boardCustomText == null || data.boardCustomText is string)
        && data.standardMonthlyFee is number && data.standardMonthlyFee >= 0
        && data.standardInstallmentFee is number && data.standardInstallmentFee >= 0
        && data.active == true
        && data.studentCount == 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(batchFields());
    }

    // A plain `.update()` (e.g. `setActive` toggling just `active`) only
    // merges the given fields onto whatever the document already has -
    // for a batch created before Set 10, that means the resulting
    // document still has NONE of the fields added here (they were never
    // written, not even as null). This validator has to tolerate that -
    // "field is absent" is fine, "field is present but the wrong shape"
    // is not - so an old batch's operational active/inactive toggle
    // keeps working without first forcing a full edit-form migration,
    // while a real edit-form save (which always supplies every field)
    // is still fully validated as normal.
    function batchUpdateIsValid() {
      let data = request.resource.data;
      let keys = data.keys();
      return data.name is string && data.name.size() >= 2
        && (!keys.hasAny(['batchCode']) || data.batchCode == null || data.batchCode is string)
        && (!keys.hasAny(['description']) || data.description == null || data.description is string)
        && (!keys.hasAny(['academicSessionId']) || data.academicSessionId is string)
        && (!keys.hasAny(['classId']) || data.classId is string)
        && (!keys.hasAny(['boardId']) || data.boardId == null || data.boardId is string)
        && (!keys.hasAny(['boardCustomText']) || data.boardCustomText == null || data.boardCustomText is string)
        && data.standardMonthlyFee is number && data.standardMonthlyFee >= 0
        && data.standardInstallmentFee is number && data.standardInstallmentFee >= 0
        && data.active is bool
        && (!keys.hasAny(['studentCount']) || (data.studentCount is number && data.studentCount >= 0))
        && data.createdAt == resource.data.createdAt
        && data.updatedAt is timestamp
        && keys.hasOnly(batchFields());
    }

    match /batches/{batchId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin() && newBatchIsValid();
      allow update: if isAdmin() && batchUpdateIsValid();
      allow delete: if false;
    }

    // Student attendance (Set 4, extended Set 13 with an academicSessionId/
    // classId snapshot and a createdBy/updatedBy split replacing the old
    // single `markedBy`): one record per batch/date, covering the whole
    // batch - never split by subject. Document id is deterministic
    // (`<batchId>_<dateKey>`), checked below, so the same batch/date can
    // never produce two records - marking again just updates the one that
    // exists (admin-only, matching the spec exactly). A batch belongs to
    // exactly one session (Set 10), so `<batchId>_<dateKey>` already
    // uniquely identifies session+batch+date without a session segment.
    function attendanceFields() {
      return [
        'batchId', 'dateKey', 'date', 'academicSessionId', 'classId', 'records', 'createdBy', 'updatedBy',
        'createdAt', 'updatedAt'
      ];
    }

    function newAttendanceIsValid(recordId) {
      let data = request.resource.data;
      return recordId == data.batchId + '_' + data.dateKey
        && data.batchId is string
        && data.dateKey is string
        && data.date is timestamp
        && data.academicSessionId is string && data.academicSessionId.size() > 0
        && data.classId is string && data.classId.size() > 0
        && data.records is map
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(attendanceFields());
    }

    // The app always writes the full current shape via `.set()` (never a
    // partial `.update()`), so a pre-Set-13 document being re-marked is
    // always replaced wholesale with the new shape - `keys().hasOnly(...)`
    // needs no special tolerance for the old `markedBy` field, which
    // simply won't be in the new document. The one thing that DOES need
    // tolerance is comparing against a field the OLD document might not
    // have had at all (academicSessionId/classId/createdBy didn't exist
    // before Set 13) - guarded below so editing a historical record for
    // the first time under these rules doesn't error out.
    function attendanceUpdateIsValid() {
      let data = request.resource.data;
      let old = resource.data;
      return data.batchId == old.batchId
        && data.dateKey == old.dateKey
        && data.date == old.date
        && data.createdAt == old.createdAt
        && (!old.keys().hasAny(['academicSessionId']) || data.academicSessionId == old.academicSessionId)
        && (!old.keys().hasAny(['classId']) || data.classId == old.classId)
        && (!old.keys().hasAny(['createdBy']) || data.createdBy == old.createdBy)
        && data.academicSessionId is string && data.academicSessionId.size() > 0
        && data.classId is string && data.classId.size() > 0
        && data.records is map
        && data.createdBy is string
        && data.updatedBy is string
        && data.keys().hasOnly(attendanceFields());
    }

    // Student branch is scoped by the record's `batchId` (queryable via
    // `.where('batchId', ==, ...)`, which Firestore's `list` rule
    // evaluation requires - it can't verify an unconstrained scan
    // against a per-document map-membership check like
    // `records.keys().hasAny([uid])`, since nothing in such a query
    // provably guarantees every possible result matches). This uses the
    // student's CURRENT batch (like homework/assignments/tests), not
    // batch membership at the time attendance was taken - a student
    // moved to a different batch loses access to the old batch's
    // history. Accepted trade-off: correctness of "can this query even
    // run" beats preserving access to a superseded batch's records.
    // Set 23 KNOWN, DOCUMENTED LIMITATION - read this before touching
    // teacher write access here: attendance is deliberately BATCH-level,
    // never subject-level (Set 13's own design; Set 23 section 4
    // explicitly forbids inventing a subject field just to make this
    // check easier). `teacherIsAssignedTo` (used by academicWork/tests/
    // testResults below) needs an EXACT subjectId to build the
    // deterministic assignment document id - but a batch may have
    // several different subject-assignments (Set 9 seeds classes with up
    // to 10 subjects each), and Firestore Security Rules can only
    // perform a bounded, fixed number of `get()`/`exists()` calls (10 per
    // single-document request - confirmed against Firebase's own rules
    // documentation), with no query/loop construct available to check
    // "does ANY of this teacher's assignments, for an unknown subject,
    // match this batch" - that would need either an unbounded/oversized
    // number of calls (unsafe - a class with many configured subjects
    // could exceed the budget and start failing closed unpredictably) or
    // a second, denormalized index of assignment data (explicitly
    // prohibited - "do not duplicate assignment data"), or Firebase Auth
    // custom claims (requires the Admin SDK / Cloud Functions - explicitly
    // prohibited on this Spark-plan project). None of those are safe or
    // permitted, so this is NOT rules-enforced per-assignment.
    //
    // What IS enforced: role (`isTeacher()`, same broad grant already
    // documented for `students`/`tests`/`academicWork` reads since Set
    // 8/14/16 - "any active teacher may work with any batch", now
    // extended to this one write path too) plus full shape validation
    // (`newAttendanceIsValid`/`attendanceUpdateIsValid`, unchanged). The
    // APPLICATION restricts which batch a teacher can select in the
    // first place - `MarkStudentAttendanceScreen`'s teacher path only
    // ever offers batches drawn from `ownTeacherAssignmentsProvider`
    // (Set 22's rule-constrained self-read) - which is real protection
    // against an accidental scope violation through the UI, but is not a
    // hard security boundary against a deliberately crafted direct API
    // write. This is the SAME class of accepted, explicitly-documented
    // trade-off this project has made before, not a new or lesser
    // standard invented for Set 23.
    //
    // Set 24 re-investigated this from first principles (re-confirmed the
    // 10-call budget against Firebase's own docs, re-costed a bounded
    // check against both the class's and the teacher's own subject
    // lists, and identified but deliberately rejected the one
    // architectural change that would close it - see docs/database-
    // architecture.md's "Teacher-scoped Firestore rules (Set 23-24)" for
    // the full writeup) and made NO change here: this remains the
    // safest practical implementation available under this project's
    // constraints, not an unexamined carry-over.
    match /attendance/{recordId} {
      allow get: if isAdmin() || isTeacher() || isStudentOfBatch(resource.data.batchId);
      allow list: if isAdmin() || isTeacher() || isStudentOfBatch(resource.data.batchId);
      allow create: if (isAdmin() || isTeacher()) && newAttendanceIsValid(recordId);
      allow update: if (isAdmin() || isTeacher()) && attendanceUpdateIsValid();
      allow delete: if false;
    }

    // Teacher attendance (Set 4, extended Set 13 with a createdBy/
    // updatedBy split replacing the old single `markedBy`): one record
    // per teacher/date, same duplicate-prevention scheme as student
    // attendance. Admin-only to write - "teacher cannot edit attendance
    // unless explicitly permitted by admin", and no such permission
    // exists yet in this phase.
    function teacherAttendanceFields() {
      return ['teacherUid', 'dateKey', 'date', 'status', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'];
    }

    function newTeacherAttendanceIsValid(recordId) {
      let data = request.resource.data;
      return recordId == data.teacherUid + '_' + data.dateKey
        && data.teacherUid is string
        && data.dateKey is string
        && data.date is timestamp
        && data.status in ['present', 'absent']
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(teacherAttendanceFields());
    }

    // Same reasoning as attendanceUpdateIsValid: writes always replace
    // the full document, but the `createdBy` old-value comparison is
    // guarded since a pre-Set-13 document never had that field.
    function teacherAttendanceUpdateIsValid() {
      let data = request.resource.data;
      let old = resource.data;
      return data.teacherUid == old.teacherUid
        && data.dateKey == old.dateKey
        && data.createdAt == old.createdAt
        && (!old.keys().hasAny(['createdBy']) || data.createdBy == old.createdBy)
        && data.status in ['present', 'absent']
        && data.createdBy is string
        && data.updatedBy is string
        && data.keys().hasOnly(teacherAttendanceFields());
    }

    match /teacherAttendance/{recordId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.teacherUid == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.teacherUid == request.auth.uid);
      allow create: if isAdmin() && newTeacherAttendanceIsValid(recordId);
      allow update: if isAdmin() && teacherAttendanceUpdateIsValid();
      allow delete: if false;
    }

    // Teacher -> class/batch/subject teaching assignments (Set 22) - the
    // ACTUAL teaching responsibility, distinct from `teachers.subjectIds`
    // (capability only). Document id is deterministic
    // (`<teacherId>_<academicSessionId>_<batchId>_<subjectId>`, see
    // `TeacherAssignment.idFor`), so the same combination can never exist
    // as two documents - the same duplicate-prevention technique already
    // used for `attendance`/`teacherAttendance`. Admin-only to write; a
    // teacher may read only their own (`resource.data.teacherId ==
    // request.auth.uid`), matching `teacherAttendance` exactly. `classId`
    // is cross-checked against the referenced batch's own `classId`/
    // `academicSessionId` at write time (section 19 - "validate the
    // relationship in Firestore rules where feasible") via one extra
    // `get()`, the same technique `isStudentOfBatch` already uses to read
    // a related document inside a rule.
    function teacherAssignmentFields() {
      return [
        'teacherId', 'academicSessionId', 'classId', 'batchId', 'subjectId', 'active',
        'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
      ];
    }

    function assignmentBatchIsConsistent(academicSessionId, classId, batchId) {
      let batch = get(/databases/$(database)/documents/batches/$(batchId)).data;
      return batch.academicSessionId == academicSessionId && batch.classId == classId;
    }

    function newTeacherAssignmentIsValid(assignmentId) {
      let data = request.resource.data;
      return assignmentId == data.teacherId + '_' + data.academicSessionId + '_' + data.batchId + '_' + data.subjectId
        && data.teacherId is string && data.teacherId.size() > 0
        && data.academicSessionId is string && data.academicSessionId.size() > 0
        && data.classId is string && data.classId.size() > 0
        && data.batchId is string && data.batchId.size() > 0
        && data.subjectId is string && data.subjectId.size() > 0
        && data.active is bool
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(teacherAssignmentFields())
        && assignmentBatchIsConsistent(data.academicSessionId, data.classId, data.batchId);
    }

    // The app only ever updates `active`/`updatedBy`/`updatedAt`
    // (`TeacherAssignmentController.setActive`) - every identity field is
    // pinned to its previous value, so an assignment's
    // teacher/session/class/batch/subject can never be rewritten after
    // creation (section 18 - historical integrity).
    function teacherAssignmentUpdateIsValid() {
      let data = request.resource.data;
      let old = resource.data;
      return data.teacherId == old.teacherId
        && data.academicSessionId == old.academicSessionId
        && data.classId == old.classId
        && data.batchId == old.batchId
        && data.subjectId == old.subjectId
        && data.createdBy == old.createdBy
        && data.createdAt == old.createdAt
        && data.active is bool
        && data.updatedBy is string
        && data.keys().hasOnly(teacherAssignmentFields());
    }

    match /teacherAssignments/{assignmentId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.teacherId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.teacherId == request.auth.uid);
      allow create: if isAdmin() && newTeacherAssignmentIsValid(assignmentId);
      allow update: if isAdmin() && teacherAssignmentUpdateIsValid();
      allow delete: if false;
    }

    // Set 23 - teacher-scoped operational authorization, built on top of
    // Set 22's `teacherAssignments`. This is the ONE place that checks
    // "does the signed-in teacher have an active assignment matching this
    // session/class/batch/subject" - reused by academicWork/tests/
    // testResults below, all of which already carry (or can look up) a
    // `subjectId`, so the exact deterministic assignment document id is
    // fully computable and a single `exists()`+`get()` pair is enough -
    // no query, no bounded/unbounded loop needed. `classId` is checked
    // too (not just session/batch/subject): a batch's own `classId` CAN
    // change after an assignment was created (`BatchController.updateBatch`
    // allows it), and an assignment must keep authorizing only the class
    // it was actually created for (section 18 - historical integrity), not
    // silently follow the batch to a new class.
    //
    // ATTENDANCE IS THE ONE EXCEPTION (see the `attendance` match block
    // below): it has no `subjectId` field at all (Set 13's own design,
    // deliberately preserved - see `TeacherAssignment`'s doc comment on
    // why Set 23 does not invent one), so this exact technique does not
    // apply there - see that block's comment for the documented
    // limitation.
    function teacherIsAssignedTo(academicSessionId, classId, batchId, subjectId) {
      let path = /databases/$(database)/documents/teacherAssignments/$(request.auth.uid + '_' + academicSessionId + '_' + batchId + '_' + subjectId);
      return exists(path) && teacherAssignmentDataMatches(get(path).data, classId);
    }

    function teacherAssignmentDataMatches(assignment, classId) {
      return assignment.active == true && assignment.classId == classId;
    }

    // Homework and assignments, unified (Set 16 - replaces the separate
    // Set 4 `homework`/`assignments` collections; see docs/database-
    // architecture.md for the full rationale). One reusable model with a
    // `type` field, shared by every student in a batch - never one
    // document per student. academicSessionId/classId/batchId/subjectId
    // are snapshotted at creation and immutable afterward (only
    // subject/title/description/dates/status may ever change - see
    // academicWorkUpdateIsValid), matching the same historical-integrity
    // snapshot philosophy as Batch/Test/Attendance.
    //
    // Admin-only to create/update: there is still no Teacher -> Batch
    // assignment module (Set 12's own scope boundary), so there is no
    // safe way to authorize "this teacher may write to this batch" -
    // TeacherProfile.subjectIds only says which SUBJECTS a teacher can
    // teach, never which BATCHES. Teachers keep the same broad read
    // access homework/assignments/tests/attendance have always had. A
    // student may read only their current batch's PUBLISHED or CLOSED
    // work, never a draft - the `list`/`get` query must be constrained
    // by both `batchId` and `status` for this to be provable, so
    // `studentVisibleAcademicWorkProvider` always issues
    // `.where('batchId', ==, ...).where('status', whereIn: [...])`,
    // never an unconstrained scan (see "Firestore query-shape
    // requirement" below).
    function academicWorkFields() {
      return [
        'type', 'academicSessionId', 'classId', 'batchId', 'subjectId', 'subject', 'title', 'description',
        'assignedDate', 'dueDate', 'status', 'createdBy', 'createdAt', 'updatedAt'
      ];
    }

    function newAcademicWorkIsValid() {
      let data = request.resource.data;
      return data.type in ['homework', 'assignment']
        && data.academicSessionId is string && data.academicSessionId.size() > 0
        && data.classId is string && data.classId.size() > 0
        && data.batchId is string && data.batchId.size() > 0
        && data.subjectId is string && data.subjectId.size() > 0
        && data.subject is string && data.subject.size() > 0
        && data.title is string && data.title.size() > 0
        && (data.description == null || data.description is string)
        && data.assignedDate is timestamp
        && data.dueDate is timestamp
        && data.dueDate >= data.assignedDate
        && data.status in ['draft', 'published']
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(academicWorkFields());
    }

    function academicWorkUpdateIsValid() {
      let data = request.resource.data;
      let old = resource.data;
      return data.type == old.type
        && data.academicSessionId == old.academicSessionId
        && data.classId == old.classId
        && data.batchId == old.batchId
        && data.subjectId == old.subjectId
        && data.createdBy == old.createdBy
        && data.createdAt == old.createdAt
        && data.subject is string && data.subject.size() > 0
        && data.title is string && data.title.size() > 0
        && (data.description == null || data.description is string)
        && data.assignedDate is timestamp
        && data.dueDate is timestamp
        && data.dueDate >= data.assignedDate
        && data.status in ['draft', 'published', 'closed']
        && data.updatedAt is timestamp
        && data.keys().hasOnly(academicWorkFields());
    }

    // Set 23: a teacher may create/update academicWork whose session/
    // class/batch/subject matches one of their own active
    // `teacherAssignments` (checked against `resource.data` on update,
    // since `academicWorkUpdateIsValid` already pins those fields to
    // their original values - so checking the old or new document is
    // equivalent, and the old one is what's actually being authorized
    // against). Read access is UNCHANGED - still any active teacher,
    // matching the existing tests/attendance precedent (Set 8/14/16) -
    // this set only narrows WRITE access, never widens or narrows reads.
    function academicWorkTeacherScopeMatches(data) {
      return teacherIsAssignedTo(data.academicSessionId, data.classId, data.batchId, data.subjectId);
    }

    match /academicWork/{workId} {
      allow get: if isAdmin() || isTeacher()
        || (isStudentOfBatch(resource.data.batchId) && resource.data.status != 'draft');
      allow list: if isAdmin() || isTeacher()
        || (isStudentOfBatch(resource.data.batchId) && resource.data.status in ['published', 'closed']);
      allow create: if newAcademicWorkIsValid()
        && (isAdmin() || (isTeacher() && academicWorkTeacherScopeMatches(request.resource.data)));
      allow update: if academicWorkUpdateIsValid()
        && (isAdmin() || (isTeacher() && academicWorkTeacherScopeMatches(resource.data)));
      allow delete: if false;
    }

    // Admin-authored, targeted Notices (Set 17) - NOT the same collection
    // as `notifications` below (that's the Set 4/5 auto-generated event
    // trail: no admin authoring, no targeting beyond batch/student, no
    // read state). One shared document per notice, never one per
    // recipient (section 26) - a student/parent (this project has no
    // separate parent login; see `isStudentCaller` below) or teacher's
    // eligibility is entirely decided by `targetKey`, which collapses
    // audience/scope/classId/batchId into a single string BOTH written
    // and validated here and computed identically in
    // `Notice.computeTargetKey` (kept in sync by hand). Per-user read
    // state lives at `users/{uid}/noticeReadStates` above, never here.
    //
    // A brand-new item may only be `draft` or `published` (never
    // pre-`closed`, matching `newAcademicWorkIsValid`'s identical rule).
    // The lifecycle is one-way (Draft -> Published -> Closed only - see
    // `Notice`'s class doc comment for why this differs from Set 16's
    // freely-reversible `AcademicWorkStatus`): `noticeEditIsValid` only
    // allows content changes while still draft, `noticePublishIsValid`
    // only draft -> published, `noticeCloseIsValid` only published ->
    // closed - targeting/identity fields are immutable in all three.
    function noticeFields() {
      return [
        'title', 'message', 'type', 'otherTypeLabel', 'audience', 'scope', 'academicSessionId', 'classId',
        'batchId', 'targetKey', 'status', 'createdBy', 'createdAt', 'updatedAt', 'publishedAt', 'expiresAt',
        'isPublic'
      ];
    }

    // The one place `targetKey` is derived - must exactly match
    // `Notice.computeTargetKey` in Dart. `students` and `parents` produce
    // the SAME key at the same scope: both reach the one shared student/
    // parent login (see `Notice`'s `NoticeAudience` doc comment).
    function expectedNoticeTargetKey(data) {
      return data.audience == 'all'
        ? 'all'
        : data.audience == 'teachers'
          ? 'teachers'
          : data.scope == 'institute'
            ? 'students'
            : data.scope == 'class'
              ? 'students:class:' + data.classId
              : 'students:batch:' + data.batchId;
    }

    // `all`/`teachers` are always institute-wide (no class/batch - Set 17
    // section 4 has no "Class 9 - Everyone"/"Class 9 - Teachers" example);
    // `students`/`parents` may be institute-wide, one class, or one batch
    // (which also carries its class, for display - see `Notice.classId`).
    function noticeScopeIsConsistent(data) {
      return (data.audience in ['all', 'teachers']
          && data.scope == 'institute' && data.classId == null && data.batchId == null
          && data.academicSessionId == null)
        || (data.audience in ['students', 'parents'] && data.scope == 'institute'
          && data.classId == null && data.batchId == null && data.academicSessionId == null)
        || (data.audience in ['students', 'parents'] && data.scope == 'class'
          && data.classId is string && data.classId.size() > 0 && data.batchId == null)
        || (data.audience in ['students', 'parents'] && data.scope == 'batch'
          && data.classId is string && data.classId.size() > 0
          && data.batchId is string && data.batchId.size() > 0);
    }

    function newNoticeIsValid() {
      let data = request.resource.data;
      return data.title is string && data.title.size() > 0
        && data.message is string && data.message.size() > 0
        && data.type is string && data.type.size() > 0
        && (data.otherTypeLabel == null || data.otherTypeLabel is string)
        && data.audience in ['all', 'students', 'parents', 'teachers']
        && data.scope in ['institute', 'class', 'batch']
        && noticeScopeIsConsistent(data)
        && (data.academicSessionId == null || (data.academicSessionId is string && data.academicSessionId.size() > 0))
        && data.targetKey == expectedNoticeTargetKey(data)
        && data.status in ['draft', 'published']
        && (data.status == 'draft' ? data.publishedAt == null : data.publishedAt is timestamp)
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.expiresAt == null || data.expiresAt is timestamp)
        // Public-site visibility (Set 18) - admin may opt a notice in at
        // creation time (the create dialog's "Show on public website"
        // switch) or afterward via `noticePublicVisibilityUpdateIsValid`
        // below; either way it's a plain admin-controlled boolean, never
        // implied by status/audience.
        && data.isPublic is bool
        && data.keys().hasOnly(noticeFields());
    }

    // Targeting/identity never changes after creation, in any of the
    // three allowed transitions below.
    function noticeIdentityUnchanged(data, old) {
      return data.audience == old.audience
        && data.scope == old.scope
        && data.academicSessionId == old.academicSessionId
        && data.classId == old.classId
        && data.batchId == old.batchId
        && data.targetKey == old.targetKey
        && data.createdBy == old.createdBy
        && data.createdAt == old.createdAt;
    }

    // Draft -> Draft only: content may change freely.
    function noticeEditIsValid() {
      let data = request.resource.data;
      let old = resource.data;
      return old.status == 'draft' && data.status == 'draft'
        && data.publishedAt == null
        && data.title is string && data.title.size() > 0
        && data.message is string && data.message.size() > 0
        && data.type is string && data.type.size() > 0
        && (data.otherTypeLabel == null || data.otherTypeLabel is string)
        && (data.expiresAt == null || data.expiresAt is timestamp)
        && data.isPublic is bool
        && data.updatedAt is timestamp
        && noticeIdentityUnchanged(data, old)
        && data.keys().hasOnly(noticeFields());
    }

    // Draft -> Published only: content is frozen, `publishedAt` is set.
    function noticePublishIsValid() {
      let data = request.resource.data;
      let old = resource.data;
      return old.status == 'draft' && data.status == 'published'
        && data.publishedAt is timestamp
        && data.title == old.title && data.message == old.message
        && data.type == old.type && data.otherTypeLabel == old.otherTypeLabel
        && data.expiresAt == old.expiresAt
        && data.isPublic == old.isPublic
        && data.updatedAt is timestamp
        && noticeIdentityUnchanged(data, old)
        && data.keys().hasOnly(noticeFields());
    }

    // Published -> Closed only: content and `publishedAt` are frozen.
    function noticeCloseIsValid() {
      let data = request.resource.data;
      let old = resource.data;
      return old.status == 'published' && data.status == 'closed'
        && data.publishedAt == old.publishedAt
        && data.title == old.title && data.message == old.message
        && data.type == old.type && data.otherTypeLabel == old.otherTypeLabel
        && data.expiresAt == old.expiresAt
        && data.isPublic == old.isPublic
        && data.updatedAt is timestamp
        && noticeIdentityUnchanged(data, old)
        && data.keys().hasOnly(noticeFields());
    }

    // Toggling public-site visibility only (Set 18) - reachable at ANY
    // status, unlike edit/publish/close above, since "only Admin can
    // change public visibility" is never described as tied to the
    // draft/published/closed lifecycle. A partial `.update()`
    // (`changedKeys()`, not `data.keys().hasOnly(...)`), matching
    // `testUpdateIsValid`'s identical "restricted partial update" shape.
    function noticePublicVisibilityUpdateIsValid() {
      return changedKeys().hasOnly(['isPublic', 'updatedAt'])
        && request.resource.data.isPublic is bool
        && request.resource.data.updatedAt is timestamp;
    }

    function noticeUpdateIsValid() {
      return noticeEditIsValid() || noticePublishIsValid() || noticeCloseIsValid()
        || noticePublicVisibilityUpdateIsValid();
    }

    // This project has no separate parent account - a parent signs in
    // as the student (see docs/database-architecture.md) - so "is this
    // caller eligible for a students/parents-audience notice" is exactly
    // `isStudentOfBatch`'s existing active-student check, just without a
    // specific batch to compare yet (that's `targetKey` membership,
    // below).
    // Same .get(key, default) reasoning as isStudentOfBatch above.
    function isStudentCaller() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && callerStudentDoc().get('active', false) == true;
    }

    // The finite set of `targetKey` values THIS caller may ever receive -
    // built from their own current class/batch (Set 17 section 20: use
    // CURRENT context, never the notice's original one). Reused for both
    // `get`/`list` below and for the client query in
    // `myNoticesProvider`/`notice_repository.dart`, so the query's own
    // `targetKey whereIn [...]` filter is exactly what this function
    // checks - the "Firestore query-shape requirement" this project's
    // docs describe: a `list` rule branch that depends on a per-document
    // field is only provable when the query itself is constrained to
    // match.
    // Same .get(key, default) reasoning as isStudentOfBatch above - a
    // student document missing classId/batchId gets '' for each (never
    // matching any real notice's targetKey, so still correctly denied),
    // rather than throwing.
    function studentNoticeTargetKeys() {
      let s = callerStudentDoc();
      return ['all', 'students', 'students:class:' + s.get('classId', ''), 'students:batch:' + s.get('batchId', '')];
    }

    match /notices/{noticeId} {
      // The last disjunct needs no sign-in at all (Set 18) - an
      // unauthenticated visitor may read a notice that is BOTH
      // `published` AND explicitly `isPublic`, nothing else (never a
      // draft, never a private notice, regardless of audience/scope).
      // `publicNoticesProvider` always queries `.where('status', ==,
      // 'published').where('isPublic', ==, true)` (two plain equality
      // fields) so this branch is provable for that query shape - see
      // docs/database-architecture.md's "Public notices (Set 18)".
      allow get, list: if isAdmin()
        || (isTeacher() && resource.data.status == 'published' && resource.data.targetKey in ['all', 'teachers'])
        || (resource.data.status == 'published' && isStudentCaller()
          && resource.data.targetKey in studentNoticeTargetKeys())
        || (resource.data.status == 'published' && resource.data.isPublic == true);
      allow create: if isAdmin() && newNoticeIsValid();
      allow update: if isAdmin() && noticeUpdateIsValid();
      allow delete: if false;
    }

    // Offline tests (Set 4, extended Set 14 with academicSessionId/
    // classId/subjectId snapshots of the batch/subject at creation time,
    // and an active/inactive status reusing the same convention as
    // Batch/Teacher/Student - see docs/database-architecture.md). Marks
    // live in the separate `testResults` collection below. Once created,
    // only `resultPublished` (one-way: false -> true only) and `active`
    // may ever change - every other field is fixed at creation, since
    // the offline test already happened and there's nothing else to
    // edit. Set 14 spec: admin remains the sole authority for
    // creating/editing tests - teachers may still read, never write.
    function testFields() {
      return [
        'batchId', 'academicSessionId', 'classId', 'subjectId', 'subject', 'title', 'chapterTopic', 'date',
        'totalMarks', 'testType', 'otherTestTypeLabel', 'description', 'active', 'resultPublished', 'createdBy',
        'createdAt', 'updatedAt'
      ];
    }

    function newTestIsValid() {
      let data = request.resource.data;
      return data.batchId is string
        && data.academicSessionId is string && data.academicSessionId.size() > 0
        && data.classId is string && data.classId.size() > 0
        && data.subjectId is string && data.subjectId.size() > 0
        && data.subject is string && data.subject.size() > 0
        && data.title is string && data.title.size() > 0
        && data.chapterTopic is string
        && data.date is timestamp
        && data.totalMarks is number && data.totalMarks > 0
        && data.testType in ['unitTest', 'monthlyTest', 'weeklyTest', 'halfYearly', 'finalTest', 'other']
        && (data.otherTestTypeLabel == null || data.otherTestTypeLabel is string)
        && (data.description == null || data.description is string)
        && data.active == true
        && data.resultPublished == false
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(testFields());
    }

    function testUpdateIsValid() {
      return changedKeys().hasOnly(['resultPublished', 'active', 'updatedAt'])
        && (!changedKeys().hasAny(['resultPublished']) || request.resource.data.resultPublished == true)
        && (!changedKeys().hasAny(['active']) || request.resource.data.active is bool);
    }

    // Set 23: a teacher may create a test, or publish/(de)activate one
    // they can create, whenever its session/class/batch/subject matches
    // one of their own active `teacherAssignments` - see
    // `teacherIsAssignedTo` above. `newTestIsValid` already pins
    // `createdBy == request.auth.uid`; `testUpdateIsValid` already
    // restricts an update to `resultPublished`/`active`/`updatedAt` only,
    // so the scope check for update is against `resource.data` (the
    // test's permanent, unchangeable session/class/batch/subject).
    // Read access is UNCHANGED (any active teacher, same as before).
    function testTeacherScopeMatches(data) {
      return teacherIsAssignedTo(data.academicSessionId, data.classId, data.batchId, data.subjectId);
    }

    match /tests/{testId} {
      allow get: if isAdmin() || isTeacher() || isStudentOfBatch(resource.data.batchId);
      allow list: if isAdmin() || isTeacher() || isStudentOfBatch(resource.data.batchId);
      allow create: if newTestIsValid()
        && (isAdmin() || (isTeacher() && testTeacherScopeMatches(request.resource.data)));
      allow update: if testUpdateIsValid()
        && (isAdmin() || (isTeacher() && testTeacherScopeMatches(resource.data)));
      allow delete: if false;
    }

    // Test results / marks (Set 4, extended Set 14 with an `isAbsent`
    // flag so a student who did not attempt the test is distinguishable
    // from one who scored a genuine zero - `obtainedMarks` is `null`
    // whenever `isAbsent` is true, never a stand-in `0`): one document
    // per test+student (deterministic id `<testId>_<studentUid>`, same
    // duplicate-prevention scheme as attendance). "Do not expose
    // unpublished marks to students" is enforced right here: a student
    // can only ever `get` their own result, and only once the parent
    // test's `resultPublished` is true. Admin may always write (Set 14);
    // Set 23 additionally allows a teacher to write marks for a test
    // whose session/class/batch/subject matches one of their own active
    // `teacherAssignments` - checked via the PARENT test document (a
    // `testResult` itself carries no subjectId/session/class), the same
    // `get()`-a-related-document technique `testIsPublished` already
    // uses. "Do not trust the test id alone" (section 11) - the parent
    // test is actually read and its own scope checked, not merely
    // assumed from whatever the client claims.
    function testResultFields() {
      return ['testId', 'studentUid', 'batchId', 'isAbsent', 'obtainedMarks', 'totalMarks', 'remark', 'enteredBy',
        'createdAt', 'updatedAt'];
    }

    function testIsPublished(testId) {
      return get(/databases/$(database)/documents/tests/$(testId)).data.resultPublished == true;
    }

    // Either genuinely absent (no marks value at all) or present with a
    // valid in-range mark - never both, never neither.
    function marksAreValid(data) {
      return data.isAbsent is bool
        && (
          (data.isAbsent == true && data.obtainedMarks == null)
          || (
            data.isAbsent == false && data.obtainedMarks is number
            && data.obtainedMarks >= 0 && data.obtainedMarks <= data.totalMarks
          )
        );
    }

    function newTestResultIsValid(resultId) {
      let data = request.resource.data;
      return resultId == data.testId + '_' + data.studentUid
        && data.testId is string
        && data.studentUid is string
        && data.batchId is string
        && data.totalMarks is number
        && marksAreValid(data)
        && (data.remark == null || data.remark is string)
        && data.enteredBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(testResultFields());
    }

    function testResultUpdateIsValid() {
      let data = request.resource.data;
      let old = resource.data;
      return data.testId == old.testId
        && data.studentUid == old.studentUid
        && data.batchId == old.batchId
        && data.createdAt == old.createdAt
        && data.totalMarks is number
        && marksAreValid(data)
        && (data.remark == null || data.remark is string)
        && data.enteredBy is string
        && data.keys().hasOnly(testResultFields());
    }

    function testResultTeacherScopeMatches(testId) {
      let test = get(/databases/$(database)/documents/tests/$(testId)).data;
      return teacherIsAssignedTo(test.academicSessionId, test.classId, test.batchId, test.subjectId);
    }

    match /testResults/{resultId} {
      allow get: if isAdmin() || isTeacher() || (isSelf(resource.data.studentUid) && testIsPublished(resource.data.testId));
      allow list: if isAdmin() || isTeacher();
      allow create: if newTestResultIsValid(resultId)
        && (isAdmin() || (isTeacher() && testResultTeacherScopeMatches(request.resource.data.testId)));
      allow update: if testResultUpdateIsValid()
        && (isAdmin() || (isTeacher() && testResultTeacherScopeMatches(resource.data.testId)));
      allow delete: if false;
    }

    // Notification event hooks (Set 4/5): a durable record of
    // homework/assignment/test/result/fee-payment/announcement events, in
    // the shape a future push sender - or the in-app feed added in Set 5
    // - can consume. Not a delivery mechanism itself (no Cloud Functions
    // in this project). `batchId` is null for a broadcast event
    // (currently only announcements); `studentUid` targets one student
    // specifically (currently only fee payments) on top of/instead of a
    // batch. Distinct from `notices` above (Set 17): this collection is
    // auto-generated by other features' controllers and read-only for
    // every role; `notices` is admin-authored, has a draft/published/
    // closed lifecycle, and per-user read state. Neither collection
    // feeds the other - see docs/database-architecture.md.
    function notificationFields() {
      return ['type', 'batchId', 'studentUid', 'title', 'body', 'relatedId', 'createdAt'];
    }

    function newNotificationIsValid() {
      let data = request.resource.data;
      return data.type in ['homework', 'assignment', 'test', 'result', 'feePayment', 'announcement']
        && (data.batchId == null || data.batchId is string)
        && data.title is string
        && data.body is string
        && data.relatedId is string
        && data.createdAt is timestamp
        && data.keys().hasOnly(notificationFields());
    }

    function isTargetOfNotification() {
      let data = resource.data;
      return data.batchId == null
        || (data.studentUid is string && isSelf(data.studentUid))
        || isStudentOfBatch(data.batchId);
    }

    match /notifications/{notificationId} {
      allow get: if isAdmin() || isTeacher() || isTargetOfNotification();
      allow list: if isAdmin() || isTeacher() || isTargetOfNotification();
      allow create: if (isAdmin() || isTeacher()) && newNotificationIsValid();
      allow update, delete: if false;
    }

    // Public content (Set 5): gallery, banners, upcoming-batch listings
    // and popup advertisements. All are institute-curated marketing
    // content with no personal/student data in their schema, so they are
    // readable **without signing in** - that's the point, they power the
    // public (no-login) site. Only admin may write. Rules gate on
    // `active` only; the precise banner/ad display-period window is
    // filtered client-side (see BannerItem.isLive / Advertisement.isLive)
    // since it doesn't need to be a security boundary.
    function publicContentIsValid(fields) {
      return request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.active is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(fields);
    }

    function publicContentUpdateIsValid(fields) {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(fields);
    }

    match /gallery/{itemId} {
      allow get, list: if resource.data.active == true || isAdmin();
      allow create: if isAdmin()
        && publicContentIsValid(['imageUrl', 'title', 'description', 'category', 'active', 'createdAt', 'updatedAt'])
        && request.resource.data.imageUrl is string;
      allow update: if isAdmin()
        && publicContentUpdateIsValid(['imageUrl', 'title', 'description', 'category', 'active', 'createdAt', 'updatedAt']);
      allow delete: if false;
    }

    match /banners/{bannerId} {
      allow get, list: if resource.data.active == true || isAdmin();
      allow create: if isAdmin()
        && publicContentIsValid([
          'imageUrl', 'title', 'description', 'ctaText', 'ctaUrl', 'active', 'displayFrom', 'displayUntil',
          'sortOrder', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.imageUrl is string
        && request.resource.data.sortOrder is int;
      allow update: if isAdmin()
        && publicContentUpdateIsValid([
          'imageUrl', 'title', 'description', 'ctaText', 'ctaUrl', 'active', 'displayFrom', 'displayUntil',
          'sortOrder', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.sortOrder is int;
      allow delete: if false;
    }

    match /upcomingBatches/{batchId} {
      allow get, list: if resource.data.active == true || isAdmin();
      allow create: if isAdmin()
        && publicContentIsValid([
          'posterUrl', 'title', 'className', 'board', 'academicSession', 'startDate', 'timing', 'description',
          'admissionStatus', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.className is string
        && request.resource.data.board is string
        && request.resource.data.academicSession is string
        && request.resource.data.startDate is timestamp
        && request.resource.data.timing is string
        && request.resource.data.admissionStatus is string;
      allow update: if isAdmin()
        && publicContentUpdateIsValid([
          'posterUrl', 'title', 'className', 'board', 'academicSession', 'startDate', 'timing', 'description',
          'admissionStatus', 'active', 'createdAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /advertisements/{adId} {
      allow get, list: if resource.data.active == true || isAdmin();
      allow create: if isAdmin()
        && publicContentIsValid([
          'posterUrl', 'title', 'description', 'buttonText', 'buttonUrl', 'active', 'startDate', 'endDate',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.posterUrl is string;
      allow update: if isAdmin()
        && publicContentUpdateIsValid([
          'posterUrl', 'title', 'description', 'buttonText', 'buttonUrl', 'active', 'startDate', 'endDate',
          'createdAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow get, list: if resource.data.active == true || isAdmin();
      allow create: if isAdmin()
        && publicContentIsValid(['title', 'body', 'active', 'createdAt', 'updatedAt'])
        && request.resource.data.body is string;
      allow update: if isAdmin() && publicContentUpdateIsValid(['title', 'body', 'active', 'createdAt', 'updatedAt']);
      allow delete: if false;
    }

    // The single institute-profile document (Set 5, extended Set 9 with
    // logoUrl/secondaryPhone/website as the central institute
    // configuration) - public branding/about/contact info powering the
    // public site. Not a managed collection of many institutes; always
    // `institutes/main`.
    match /institutes/{instituteId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && instituteId == 'main'
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'name', 'tagline', 'about', 'logoUrl', 'contactPhone', 'secondaryPhone', 'contactEmail', 'address',
          'website', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Visitor enquiries (Set 5, extended Set 18): submitted by an
    // unauthenticated public visitor - `create` needs no sign-in, only a
    // well-formed payload. Only admin may read or manage them afterwards
    // (there is deliberately no "telecaller" role - see the spec).
    // `enquiryType` (Set 18) distinguishes an admission enquiry from a
    // "request a callback" - one collection, one form of visitor intent,
    // not two unrelated database systems (Set 18 section 15); `classId`/
    // `boardId` (Set 18) reference the existing Set 9 master data instead
    // of free text, required only for `enquiryType == 'admission'` (a
    // callback request is intentionally lighter-weight and needs
    // neither). `className`/`board` alongside them are resolved display
    // strings, the same "id + display name" snapshot convention used
    // everywhere else in this project (e.g. `AcademicWork.subjectId`/
    // `.subject`). `boardCustomText` is set only when `boardId` is
    // "others". Field-length caps and a freshness check on `createdAt`
    // (Set 18 section 20's lightweight anti-abuse, since this project has
    // no Cloud Functions/App Check to do more) are this collection's only
    // defense against a malformed or abusive unauthenticated payload -
    // `get`/`list`/`update`/`delete` all stay admin-only exactly as
    // before, and a visitor can never set `status` to anything but the
    // initial value.
    function enquiryFields() {
      return [
        'name', 'guardianName', 'enquiryType', 'classId', 'className', 'boardId', 'board', 'boardCustomText',
        'primaryPhone', 'secondaryPhone', 'message', 'status', 'createdAt', 'updatedAt'
      ];
    }

    function enquiryTimestampIsFresh(data) {
      return data.createdAt > request.time - duration.value(10, 'm')
        && data.createdAt < request.time + duration.value(10, 'm');
    }

    function newEnquiryIsValid() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (data.guardianName == null || (data.guardianName is string && data.guardianName.size() <= 100))
        && data.enquiryType in ['admission', 'callback']
        && (data.classId == null || (data.classId is string && data.classId.size() > 0))
        && (data.className == null || (data.className is string && data.className.size() <= 60))
        && (data.boardId == null || (data.boardId is string && data.boardId.size() > 0))
        && (data.board == null || (data.board is string && data.board.size() <= 60))
        && (data.boardCustomText == null || (data.boardCustomText is string && data.boardCustomText.size() <= 60))
        && (data.enquiryType != 'admission'
          || (data.classId is string && data.className is string && data.boardId is string))
        && data.primaryPhone is string && data.primaryPhone.size() >= 6 && data.primaryPhone.size() <= 20
        && (data.secondaryPhone == null || (data.secondaryPhone is string && data.secondaryPhone.size() <= 20))
        && (data.message == null || (data.message is string && data.message.size() <= 1000))
        && data.status == 'newEnquiry'
        && data.createdAt is timestamp
        && enquiryTimestampIsFresh(data)
        && data.updatedAt is timestamp
        && data.keys().hasOnly(enquiryFields());
    }

    function enquiryUpdateIsValid() {
      return changedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['newEnquiry', 'contacted', 'followUp', 'admissionDone', 'notInterested'];
    }

    match /enquiries/{enquiryId} {
      allow get, list: if isAdmin();
      allow create: if newEnquiryIsValid();
      allow update: if isAdmin() && enquiryUpdateIsValid();
      allow delete: if false;
    }

    // Legacy callback requests (Set 5, pre-Set-18) - kept exactly as
    // shipped, read-only history. Set 18 moves the "request a callback"
    // form to write into `enquiries` (`enquiryType: 'callback'`) above
    // instead, so no NEW documents are created here going forward; this
    // collection and its admin screen remain solely so requests already
    // collected before Set 18 stay visible, per "preserve working
    // functionality" / "historical data must remain available".
    function newCallbackRequestIsValid() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0
        && data.phone is string && data.phone.size() >= 6
        && data.status == 'newRequest'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(['name', 'phone', 'message', 'status', 'createdAt', 'updatedAt']);
    }

    function callbackRequestUpdateIsValid() {
      return changedKeys().hasOnly(['status', 'updatedAt']) && request.resource.data.status in ['newRequest', 'contacted'];
    }

    match /callbackRequests/{requestId} {
      allow get, list: if isAdmin();
      allow create: if newCallbackRequestIsValid();
      allow update: if isAdmin() && callbackRequestUpdateIsValid();
      allow delete: if false;
    }

    // Saved export/report configurations (Set 6) - "Basic Student List"
    // style reusable templates for the export engine. Admin-only tooling
    // (only admin ever reaches the export screens), and unlike the
    // append-only collections above, a template genuinely may be deleted
    // - it's a saved preference, not a durable record. `config` is a
    // free-form map (selected columns/filters/sort/mode/format) - its
    // shape is validated client-side by whichever export screen reads it,
    // not here, since it varies per module and carries no access-control
    // meaning of its own.
    function newReportTemplateIsValid() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0
        && data.module in ['studentExport', 'feeDuesExport', 'testResultExport', 'paymentReport']
        && data.config is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(['name', 'module', 'config', 'createdAt', 'updatedAt']);
    }

    match /reportTemplates/{templateId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && newReportTemplateIsValid();
      allow update: if isAdmin() && newReportTemplateIsValid();
      allow delete: if isAdmin();
    }

    // Report *layout* templates (Set 7) - a different thing from
    // `reportTemplates` above despite the similar name: this is the
    // visual A4 letterhead (logo position/size, header text, footer/
    // signature/page-number config), not an export's column/filter
    // choices. Admin-only, freely deletable - same reasoning as
    // `reportTemplates`. `header`/`footer` are validated only at the
    // top level (they're maps); their nested shape is defined and
    // interpreted entirely by ReportHeaderConfig/ReportFooterConfig on
    // the client and carries no access-control meaning of its own.
    function newReportLayoutTemplateIsValid() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0
        && data.header is map
        && data.footer is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(['name', 'header', 'footer', 'createdAt', 'updatedAt']);
    }

    match /reportLayoutTemplates/{templateId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && newReportLayoutTemplateIsValid();
      allow update: if isAdmin() && newReportLayoutTemplateIsValid();
      allow delete: if isAdmin();
    }

    // Academic master data (Set 9): academic sessions, classes, boards,
    // subjects. All four are "shared reference catalogues" like
    // `batches` - not personal data - only admin may write. None allow
    // `delete` - "prefer deactivation/archiving instead of destructive
    // deletion" (Set 9's data-safety requirement) - an `active` flag is
    // the only way to retire an entry. "Only one active academic
    // session" is enforced client-side via an atomic WriteBatch (see
    // AcademicSessionController), not here - a rule can't inspect
    // sibling documents to enforce a collection-wide invariant, and
    // getting this wrong has no security consequence (a display
    // inconsistency, not unauthorized access).
    //
    // `classes` and `boards` specifically are public (Set 18 section
    // 21) - the public admission-enquiry form needs to populate its
    // Class/Board pickers without requiring sign-in, and both
    // collections contain only safe catalogue data (a name, a sort
    // order, an active flag, and - for classes - a list of internal
    // subject ids that are themselves just names, nothing personal or
    // administrative). `academicSessions`/`subjects` stay signed-in-only
    // exactly as before - the public enquiry form has no use for either,
    // so neither is widened "automatically".
    function newAcademicSessionIsValid() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0
        && data.startDate is timestamp
        && data.endDate is timestamp
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(['name', 'startDate', 'endDate', 'isActive', 'createdAt', 'updatedAt']);
    }

    match /academicSessions/{sessionId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && newAcademicSessionIsValid();
      allow delete: if false;
    }

    function newSchoolClassIsValid() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0
        && data.sortOrder is number
        && data.active is bool
        && data.subjectIds is list
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(['name', 'sortOrder', 'active', 'subjectIds', 'createdAt', 'updatedAt']);
    }

    match /classes/{classId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && newSchoolClassIsValid();
      allow delete: if false;
    }

    function newBoardIsValid() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(['name', 'active', 'createdAt', 'updatedAt']);
    }

    match /boards/{boardId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && newBoardIsValid();
      allow delete: if false;
    }

    function newSubjectIsValid() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(['name', 'active', 'createdAt', 'updatedAt']);
    }

    match /subjects/{subjectId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && newSubjectIsValid();
      allow delete: if false;
    }

    // Atomic sequence counters (Set 11) - currently only `counters/students`,
    // read-then-incremented in one transaction by SequenceService to hand
    // out unique admission numbers without a Cloud Function. `nextNumber`
    // may only ever increase, never be set backwards or reused - `list`
    // is denied outright since nothing ever needs to enumerate counters,
    // only read one by its known id.
    function newCounterIsValid() {
      return request.resource.data.nextNumber is number && request.resource.data.nextNumber >= 1
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(['nextNumber', 'updatedAt']);
    }

    function counterUpdateIsValid() {
      return request.resource.data.nextNumber is number && request.resource.data.nextNumber > resource.data.nextNumber
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(['nextNumber', 'updatedAt']);
    }

    match /counters/{counterId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin() && newCounterIsValid();
      allow update: if isAdmin() && counterUpdateIsValid();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
